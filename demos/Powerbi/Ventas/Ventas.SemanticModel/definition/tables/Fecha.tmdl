/// Calendario diario (dim_fecha), del 1 de enero del primer año con pedidos al 31 de diciembre del año siguiente al último. Marcada como tabla de fechas.
table Fecha
	lineageTag: 8a98ebb2-139c-47a0-93f5-7289eec23a8c
	dataCategory: Time

	/// Texto con los filtros de Año, Región y Categoría que se aplican a la página (los segmentadores están en la portada y ocultos en cada página). No es una medida de negocio.
	measure 'Filtros aplicados' =
			VAR _anio = IF(ISFILTERED('Fecha'[Año]), CONCATENATEX(VALUES('Fecha'[Año]), 'Fecha'[Año], ", ", 'Fecha'[Año], ASC), "todos")
			VAR _region = IF(ISFILTERED('Territorio'[Grupo]), CONCATENATEX(VALUES('Territorio'[Grupo]), 'Territorio'[Grupo], ", ", 'Territorio'[Grupo], ASC), "todas")
			VAR _categoria = IF(ISFILTERED('Producto'[Categoría]), CONCATENATEX(VALUES('Producto'[Categoría]), 'Producto'[Categoría], ", ", 'Producto'[Categoría], ASC), "todas")
			RETURN
				"Filtros · Año: " & _anio & "  ·  Región: " & _region & "  ·  Categoría: " & _categoria
		formatString: General
		displayFolder: Informe
		lineageTag: dfb56abb-8d95-4d13-a635-f60ea51a3f64

	/// Día natural. Clave de la dimensión.
	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 030d6abd-e583-457d-8431-1e16253bd12d
		summarizeBy: none
		sourceColumn: Fecha

